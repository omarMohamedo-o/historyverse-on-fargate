# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. Keep .example files.
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Ignore override files as they are usually used only locally.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include lockfile in version control
!.terraform.lock.hcl

# OS files
.DS_Store
Thumbs.db
